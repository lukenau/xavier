# Rendered by host/install.sh. hub-tmuxd: the hub's shell picker (list, start, resume
# and stop Claude Code sessions in tmux). Runtime settings: @ETC_DIR@/tmuxd.conf.
[Unit]
Description=Xavier hub-tmuxd (Claude Code sessions in tmux, for the hub's shell picker)
Requires=xavier-tmux.service
After=xavier-tmux.service

[Service]
Type=simple
User=@USER@
Group=@SOCKET_GROUP@
WorkingDirectory=~
EnvironmentFile=@ETC_DIR@/tmuxd.conf
Environment=XAVIER_RUN_DIR=/run/@RUN_NAME@
Environment=XAVIER_TMUXD_SOCKET_NAME=@TMUXD_SOCK_NAME@
Environment=XAVIER_TMUX_BIN=@TMUX_BIN@
Environment=XAVIER_TMUX_SOCKET_NAME=@TMUX_SOCKET_NAME@
Environment=XAVIER_TERM_SESSION=@TERM_SESSION@
Environment=TMUX_TMPDIR=/run/@TMUX_RUN_NAME@
Environment=PATH=@SHELL_PATH@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@PYTHON_BIN@ @LIBEXEC@/tmuxd.py
# Shared with ttyd (see xavier-ttyd.service): 0750, preserved across restarts.
RuntimeDirectory=@RUN_NAME@
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=2

# The daemon reads Claude Code's bookkeeping under the home directory and writes only its
# socket. The sessions it starts run in xavier-tmux.service, not here.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
