<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for hub-tmuxd (host/README.md, "macOS"). Fill @HOME@, @REPO@ and
  @BREW@ with sed. Owner-only socket (XAVIER_SOCKET_MODE=0600) in ~/.xavier/run, which
  hub-tmuxd itself refuses to use unless it is closed to other users. Every XAVIER_*
  setting in host/hub-tmuxd/tmuxd.conf.in can be added below.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.xavier.tmuxd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>@REPO@/host/hub-tmuxd/tmuxd.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@HOME@/.local/bin:@BREW@/bin:/usr/bin:/bin</string>
    <key>XAVIER_RUN_DIR</key>
    <string>@HOME@/.xavier/run</string>
    <key>XAVIER_SOCKET_MODE</key>
    <string>0600</string>
    <key>XAVIER_TMUX_BIN</key>
    <string>@BREW@/bin/tmux</string>
    <key>XAVIER_CLAUDE_BIN</key>
    <string>@HOME@/.local/bin/claude</string>
    <key>PYTHONDONTWRITEBYTECODE</key>
    <string>1</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>@HOME@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>@HOME@/.xavier/tmuxd.log</string>
</dict>
</plist>
